---
import Layout from '../layouts/Layout.astro';
---
<Layout title="QT' Kitchen Glen Iris - Modern Vietnamese Brunch & Dinner">
<header>
  <div class="logo">
    <img src="https://qtkitchen.com.au/wp-content/uploads/2021/01/logo_transparent_background.png" alt="QT Kitchen Logo">
  </div>
  <nav>
    <ul>
      <li><a href="#about">About Us</a></li>
      <li><a href="#functions">Functions</a></li>
      <li><a href="#careers">Careers</a></li>
      <li><a href="#menu">Menu</a></li>
      <li><a href="#contact">Contact Us</a></li>
    </ul>
  </nav>
  <a href="#book-now" class="button">Book Now</a>
</header>

<section id="hero" class="hero-section">
  <div class="hero-content">
    <h1>Vietnamese Restaurant Of The Year 2024</h1>
    <p>RCA Awards for Excellence</p>
    <a href="#book-now" class="button">Book Now</a>
  </div>
</section>

<section class="mission-section">
  <h1>Our Mission Is To Provide You With An Unforgettable Modern Vietnamese Experience In Melbourne.</h1>
  <p>
    At QT Kitchen, we are known for our modern Vietnamese cuisine, inspired by our love for fresh Australian produce,
    friendly culture & community. Our head chef Kevin comes from an international hotel background at the Mantra Group
    and is looking forward to welcoming you to his dining room.
  </p>
  <div class="buttons">
    <a href="#book-now" class="button">Book Now</a>
    <a href="#takeaway" class="button secondary">Order Takeaway</a>
  </div>
</section>

<section id="pho" class="pho-section">
  <div class="pho-content">
    <h2>Melbourne's First Hot Stone Pho</h2>
    <p>
      Our Pho is made from a secret recipe that has been tried and tested for decades. With some of Australia's fresh
      produce, it's a fantastic combination. Pho is only available for lunch at QT Kitchen and you can pick from a
      variety of flavours.
    </p>
    <a href="#view-menu" class="button link">View Menu</a>
  </div>
  <div class="pho-image">
    <img src="https://qtkitchen.com.au/wp-content/uploads/2021/03/BMW08654.jpg" alt="Hot Stone Pho">
  </div>
</section>
</Layout>